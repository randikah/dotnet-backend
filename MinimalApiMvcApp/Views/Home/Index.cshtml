@{
    ViewData["Title"] = "Home Page";
}

@model IEnumerable<MinimalApiMvcApp.Models.Laptop>

<div class="text-center">
    <h1 class="display-4">Laptop List</h1>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Brand</th>
                <th>Model</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var laptop in Model)
        {
            <tr>
                <td>@laptop.Brand</td>
                <td>@laptop.Model</td>
                <td>@laptop.Price</td>
            </tr>
        }
        </tbody>
    </table>
</div>
